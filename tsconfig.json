{
  // The page, the tests and the Vite configs. The runner's folder has a tsconfig.json of its own, without the DOM.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "inlineSources": false,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["**/*.worker.ts"]
}
