# The cloud hosting's variables: add them to the starter kit's .env (gitignored), which Vite, the runner and
# `docker compose --env-file .env` read. Only VITE_* reach the page.

# The page's: the runner server, and the store it reads files from (the same URL must open in the browser and in
# the executors, see compose.yaml).
VITE_RUNNER_URL=http://localhost:8792
VITE_STORE_URL=http://store.localhost:8790/store

# The runner's (src/hosting/cloud/runner/), never the page's:
# the executors, as it reaches them through compose.yaml's nginx; one conversation at a time each;
EXECUTOR_URLS=http://localhost:8790/executor-1,http://localhost:8790/executor-2
# the store's write token, letters and digits (the executors get it in the tenant plugin's options, so the model's code can read it);
STORE_TOKEN=
# your CoDesign licence key: it pays every model call and generated image (the same variable the dev server's proxy reads).
# Contact sales (https://img.ly/forms/contact-sales/) to get a CoDesign license key.
IMGLY_GATEWAY_API_KEY=
# who calls: the issuers of your sign-in's JWTs, comma-separated (their keys at <issuer>/.well-known/jwks.json, or
# JWKS_URL; optional TOKEN_AUDIENCE, and TOKEN_HEADER when the token is not `Authorization: Bearer`),
TOKEN_ISSUERS=
# or, for local development with `vite-node src/hosting/cloud/runner/serve.ts` on 127.0.0.1, one fixed user for every request;
RUNNER_DEV_USER=
# and the page origins that may call.
ALLOWED_ORIGINS=http://localhost:5190

# Read by docker compose only:
# your CoDesign licence key, which the executors start with and charge every export to;
IMGLY_CESDK_LICENSE=
# and any string: the token nginx adds to every request to the executors.
EXECUTOR_TOKEN=

# Read by the MCP server (src/hosting/cloud/mcp/serve.ts) only:
# who may call it, `tenant=token,…`, each sent as `Authorization: Bearer <token>`;
MCP_TOKENS=
# and its port on 127.0.0.1 (default 8791).
MCP_PORT=
