# Copy to .env (gitignored) together with the cloud hosting's variables:
#   cat .env.template src/hosting/cloud/.env.template > .env
# Vite, the runner and `docker compose --env-file .env` read it. Only VITE_* variables reach the page.

# The CE.SDK licence key of the editor in the page, the kind a CE.SDK web editor uses. Dev: a trial key.
VITE_CESDK_LICENSE=

# Optional: the gateway model id the chat starts with (default @openrouter/anthropic/claude-haiku-5.5, passed through to OpenRouter).
VITE_MODEL=
