{
  "name": "starterkit-codesign-agentic-design-manager-ts-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A CoDesign SDK starter kit: a design platform with brands, designs, a CE.SDK editor and a design agent. The page runs in the browser; the agent loop, IMG.LY's executor image and a store run on your servers.",
  "scripts": {
    "dev": "vite",
    "build:site": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/runner",
    "generate:plugin": "node scripts/generate-plugin.mjs",
    "build:runner": "vite build --config src/hosting/cloud/runner/vite.config.ts"
  },
  "dependencies": {
    "@cesdk/cesdk-js": "1.84.0",
    "@cesdk/engine": "1.84.0",
    "@earendil-works/pi-agent-core": "^0.87.1",
    "@earendil-works/pi-ai": "^0.87.1",
    "@imgly/codesign-sdk": "1.84.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "dompurify": "3.4.16",
    "jose": "6.2.12",
    "marked": "18.0.11"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.1",
    "typescript": "5.9.3",
    "vite": "^5.4.11",
    "vite-node": "3.2.4"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=22"
  }
}
